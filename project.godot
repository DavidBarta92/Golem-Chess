; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Golem"
config/version="0.1.1"
run/main_scene="uid://b2oed0tahffou"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://0axhvfpiw6je"

[autoload]

SteamManager="*res://Scripts/SteamManager.gd"
SaveIO="*res://Scripts/SaveIO.gd"
StampLibrary="*res://Scripts/StampLibrary.gd"
StampPrintLibrary="*res://Scripts/StampPrintLibrary.gd"
PackDefinitionLibrary="*res://Scripts/PackDefinitionLibrary.gd"
DeckDefinitionLibrary="*res://Scripts/DeckDefinitionLibrary.gd"
PlayerCollectionStore="*res://Scripts/PlayerCollectionStore.gd"
PlayerDeckStore="*res://Scripts/PlayerDeckStore.gd"
PlayerProgressStore="*res://Scripts/PlayerProgressStore.gd"
GameConfig="*res://GameConfig.gd"
GameController="*res://Scripts/GameController.gd"
GlobalTopBar="*res://Scenes/GlobalTopBar.tscn"
SceneTransition="*res://Scripts/SceneTransition.gd"
CursorManager="*res://Scripts/CursorManager.gd"
SettingsDataManager="*res://Scripts/Settings/SettingsDataManager.gd"
StoryProgressStore="*res://Scripts/Story/StoryProgressStore.gd"
StoryManager="*res://Scripts/Story/StoryManager.gd"
SFXManager="*res://Scripts/Audio/SFXManager.gd"
AmbienceManager="*res://Scripts/Audio/AmbienceManager.gd"
MusicManager="*res://Scripts/Audio/MusicManager.gd"
UIButtonSoundHook="*res://Scripts/Audio/UIButtonSoundHook.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/min_width=1024
window/size/min_height=576

[editor_plugins]

enabled=PackedStringArray("res://addons/stamp_pattern_editor/plugin.cfg")

[gui]

theme/custom="res://ui/themes/global_theme.tres"

[internationalization]

locale/translations=PackedStringArray("res://Localization/translations.en.translation", "res://Localization/translations.hu.translation")
locale/locale_filter_mode=1
locale/locale_filter=PackedStringArray("en", "hu")

[rendering]

renderer/rendering_method="gl_compatibility"
anti_aliasing/quality/msaa_2d=2
