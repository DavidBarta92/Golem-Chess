[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://Scripts/Settings/SettingsSection.gd" id="1_section"]
[ext_resource type="Script" path="res://Scripts/Settings/VideoElements/DisplayModeElement.gd" id="2_display_mode"]
[ext_resource type="Script" path="res://Scripts/Settings/VideoElements/ResolutionElement.gd" id="3_resolution"]
[ext_resource type="Script" path="res://Scripts/Settings/VideoElements/VSyncElement.gd" id="4_vsync"]
