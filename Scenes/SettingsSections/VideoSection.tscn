[node name="Video" type="VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3
script = ExtResource("1_section")
IDENTIFIER = "Video"

[node name="Scroll" type="ScrollContainer" parent="."]
custom_minimum_size = Vector2(0, 80)
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0
vertical_scroll_mode = 2

[node name="Content" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="DisplayMode" type="VBoxContainer" parent="Scroll/Content" node_paths=PackedStringArray("OptionsRef")]
layout_mode = 2
theme_override_constants/separation = 4
script = ExtResource("2_display_mode")
OptionsRef = NodePath("Options")

[node name="Label" type="Label" parent="Scroll/Content/DisplayMode"]
layout_mode = 2
theme_type_variation = &"FieldLabel"
text = "Display Mode"

[node name="Options" type="OptionButton" parent="Scroll/Content/DisplayMode"]
layout_mode = 2
size_flags_horizontal = 3

