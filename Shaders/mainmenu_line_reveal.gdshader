shader_type canvas_item;

// Expects a texture where R = progress along the stroke (0..1), G = random
// per-stroke start delay (0..1), B = stroke length normalized against the
// longest stroke (0..1), A = ink alpha. Generated by
// tools/generate_line_reveal_mask.py -- see that script for details.
//
// The ink gets the scene lines' ink blot (ink_blot.gdshaderinc): blotchy
// density and a wandering edge.

#include "res://Shaders/ink_blot.gdshaderinc"

uniform float time = 0.0;
uniform float base_duration : hint_range(0.1, 6.0) = 1.6;
uniform float min_duration_frac : hint_range(0.0, 1.0) = 0.45;
uniform float max_delay : hint_range(0.0, 6.0) = 1.8;
uniform float feather : hint_range(0.0, 0.2) = 0.03;
uniform vec4 line_color : source_color = vec4(0.06, 0.06, 0.08, 1.0);
// The mask's alpha is how dark the source art is, which is right for black
// ink but leaves lighter-coloured line art see-through. Scaling it back up
// (by 1 / (1 - the art's grey)) makes such strokes as solid as in the drawing.
// 1.0 leaves the mask as it is.
uniform float ink_alpha_scale = 1.0;

varying vec2 local_position;

void vertex() {
	local_position = VERTEX;
}

void fragment() {
	vec2 shift = ink_blot_wander(ink_blot_lines, local_position, 0.0);
	vec4 mask = texture(TEXTURE, UV + ink_blot_uv_shift(shift, UV, local_position));
	float progress = mask.r;
	float delay = mask.g * max_delay;
	float duration = base_duration * mix(min_duration_frac, 1.0, mask.b);
	float t = min((time - delay) / max(duration, 0.001), 1.0);
	float reveal = 1.0 - smoothstep(t, t + feather, progress);
	float ink = clamp(mask.a * ink_alpha_scale, 0.0, 1.0) * ink_blot_density(ink_blot_lines, local_position, 0.0);
	COLOR = vec4(line_color.rgb, line_color.a * ink * reveal);
}
